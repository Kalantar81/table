{
  "dataUrl": "https://fakerapi.it/api/v2/persons",
  "rowsPath": "data",
  "quantityParam": "_quantity",
  "fields": {
    "id": { "type": "index", "start": 1 },
    "name": { "template": "${firstname} ${lastname}" },
    "email": "email",
    "phone": "phone",
    "gender": "gender",
    "country": { "path": "address.country", "default": "" },
    "birthday": "birthday"
  },
  "count": 10000,
  "rowsPerPageOptions": [25, 50, 100, 250, 500],
  "initialRows": 100,
  "rowHeight": 40,
  "virtualScroll": true,
  "width": "100%",
  "height": "600px",
  "horizontalScroll": true,
  "columns": [
    { "field": "id", "header": "ID", "sortable": true, "filterable": true, "filterType": "numeric", "width": "90px", "align": "right" },
    { "field": "name", "header": "Name", "sortable": true, "filterable": true, "filterType": "text", "width": "200px" },
    { "field": "email", "header": "Email", "sortable": true, "filterable": true, "filterType": "text", "width": "240px" },
    { "field": "phone", "header": "Phone", "sortable": true, "filterable": true, "filterType": "text", "width": "170px" },
    { "field": "gender", "header": "Gender", "sortable": true, "filterable": true, "filterType": "text", "width": "120px" },
    { "field": "country", "header": "Country", "sortable": true, "filterable": true, "filterType": "text", "width": "180px" },
    { "field": "birthday", "header": "Birthday", "sortable": true, "filterable": true, "filterType": "date", "width": "140px" }
  ]
}
